# Copy to .env and fill in. Never commit .env.

# --- Database (your local PostgreSQL) ---
# Product tables (async driver). Agno's own tables use the same DB through a sync driver,
# derived automatically from this URL.
DATABASE_URL=postgresql+asyncpg://market360:change_me@localhost:5432/market360
# Schema (inside the same database) where Agno keeps its own tables
AGNO_DB_SCHEMA=agno

# --- OpenAI ---
OPENAI_API_KEY=
# Default model for all agents (confirmed against your account in Milestone 5)
DEFAULT_MODEL=gpt-4.1-mini
# Optional per-agent overrides (leave empty to use DEFAULT_MODEL)
MODEL_IDENTIFIER=
MODEL_RESEARCHER=
MODEL_FACT_CHECKER=
# Analyst and Strategist do the 'thinking' but use few tokens, so a stronger model is cheap there.
MODEL_ANALYST=gpt-4.1
MODEL_STRATEGIST=gpt-4.1
MODEL_REPORT_WRITER=

# --- Tavily (free plan: 1,000 credits/month) ---
TAVILY_API_KEY=

# --- App ---
MAX_CONCURRENT_RUNS=2
# M14: a second, targeted research round when the first leaves gaps (up to ~60 s and ~8 Tavily credits more)
RESEARCH_MORE_ENABLED=true
# M15: research each competitor / market player with its own small researcher, all at the same time
PARALLEL_RESEARCH_ENABLED=true
# Needs extra OpenTelemetry packages; leave false for now
TRACING_ENABLED=false
# Agno sends usage telemetry to agno.com when true. Keep false (local-only POC).
AGNO_TELEMETRY=false
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
